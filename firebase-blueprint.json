{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's avatar URL" },
        "email": { "type": "string", "description": "User's email address" },
        "createdAt": { "type": "timestamp", "description": "When the user was created" }
      },
      "required": ["uid", "displayName", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Premium treat or footwear item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "productType": { "type": "string", "enum": ["treat", "wear"] },
        "vendorId": { "type": "string", "description": "ID of the vendor" }
      },
      "required": ["id", "name", "price", "category", "imageUrls", "vendorId"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Vendor information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Vendor User ID" },
        "shopName": { "type": "string", "description": "Name of the shop" },
        "email": { "type": "string", "description": "Vendor email address" },
        "geminiApiKey": { "type": "string", "description": "Vendor's Gemini API Key" }
      },
      "required": ["uid", "shopName", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Optional user ID if logged in" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "instructions": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] }
      },
      "required": ["id", "date", "items", "total", "fullName", "phone", "address", "status"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a product reel",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["productId", "userId", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "User comment on a product reel",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["productId", "userId", "authorName", "rating", "comment", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Log entry tracking product deletion events and admin activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productType": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "deletedBy": { "type": "string" },
        "deletedAt": { "type": "timestamp" }
      },
      "required": ["id", "productId", "productName", "deletedBy", "deletedAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App configurations such as Google Sheets URLs",
      "type": "object",
      "properties": {
        "treatsUrl": { "type": "string" },
        "wearsUrl": { "type": "string" },
        "bestSellersUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Store products"
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "Vendor" },
      "description": "Store vendors"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Customer orders"
    },
    "/likes/{likeId}": {
      "schema": { "$ref": "Like" },
      "description": "Likes on product reels"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "Review" },
      "description": "Comments on product reels"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Admin action audit logs"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "Setting" },
      "description": "App settings configurations"
    }
  }
}
