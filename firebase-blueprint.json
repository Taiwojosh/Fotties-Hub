{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's avatar URL" },
        "email": { "type": "string", "description": "User's email address" },
        "createdAt": { "type": "timestamp", "description": "When the user was created" }
      },
      "required": ["uid", "displayName", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Premium treat or footwear item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "productType": { "type": "string", "enum": ["treat", "wear"] }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Optional user ID if logged in" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "instructions": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] }
      },
      "required": ["id", "date", "items", "total", "fullName", "phone", "address", "status"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a product reel",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["productId", "userId", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "User comment on a product reel",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["productId", "userId", "authorName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Store products"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Customer orders"
    },
    "/likes/{likeId}": {
      "schema": { "$ref": "Like" },
      "description": "Likes on product reels"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "Review" },
      "description": "Comments on product reels"
    }
  }
}
