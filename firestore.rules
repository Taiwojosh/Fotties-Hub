rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isValidId(id) { 
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Admin check: checks if the user's UID is in the /admins collection
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt']) &&
             data.keys().size() >= 4 &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
             data.createdAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'category', 'image']) &&
             data.id is string && data.id.size() >= 1 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.image is string && data.image.size() <= 1000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'date', 'items', 'total', 'fullName', 'phone', 'address', 'status']) &&
             data.id is string &&
             data.date is string &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 20 &&
             data.address is string && data.address.size() >= 1 && data.address.size() <= 500 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'authorName', 'authorPhoto', 'rating', 'comment', 'createdAt']) &&
             data.productId is string && data.productId.size() >= 1 &&
             data.userId is string && data.userId.size() >= 1 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorPhoto is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['productId', 'userId', 'createdAt']) &&
             data.productId is string && data.productId.size() >= 1 &&
             data.userId is string && data.userId.size() >= 1 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == userId && incoming().createdAt == existing().createdAt;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      // Users can see their own orders if they have a userId field
      // Anonymous users can only 'get' their order if they know the ID (no listing)
      allow get: if true; 
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isValidOrder(incoming()) &&
                    (incoming().status == 'pending') &&
                    (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        incoming().status == existing().status && // Users cannot change status
        incoming().diff(existing()).affectedKeys().hasOnly(['address', 'phone', 'fullName', 'instructions'])
      );
    }

    // Likes
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == incoming().userId && isValidLike(incoming());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == incoming().userId && isValidReview(incoming());
      // Disallow update and delete for simplicity based on ReelItem logic
      allow update, delete: if isAdmin();
    }
    
    // Admins helper collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
